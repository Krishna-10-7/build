{
  "name": "sentinelqa",
  "private": true,
  "version": "0.1.0",
  "description": "Turns ticket acceptance criteria into Playwright tests, runs them, and heals broken locators without hiding real regressions.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "shoplite": "npm run start -w @sentinelqa/shoplite",
    "server": "npm run start -w @sentinelqa/server",
    "dashboard": "npm run dev -w @sentinelqa/dashboard",
    "build": "npm run build -w @sentinelqa/dashboard && npm run build -w @sentinelqa/office",
    "bench": "tsx bench/run.ts",
    "test": "tsx --test packages/core/test/*.test.ts packages/engine/test/*.test.ts apps/server/test/*.test.ts",
    "office": "npm run dev -w @sentinelqa/office"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
