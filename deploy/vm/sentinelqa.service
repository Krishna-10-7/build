[Unit]
Description=SentinelQA orchestrator, dashboard and 3D office
After=network.target sentinelqa-shoplite.service
Wants=sentinelqa-shoplite.service

[Service]
User=sentinelqa
WorkingDirectory=/opt/sentinelqa/current
EnvironmentFile=/etc/sentinelqa/sentinelqa.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/sentinelqa/ms-playwright
ExecStart=/opt/sentinelqa/current/node_modules/.bin/tsx apps/server/src/main.ts
Restart=on-failure
# Two agents drive one Chromium each; keep headroom for the other sites on this VM.
MemoryMax=6G
CPUQuota=180%

[Install]
WantedBy=multi-user.target
