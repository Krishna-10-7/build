SENTINEL_PORT=8462
HOST=127.0.0.1
TARGET_URL=http://127.0.0.1:8461
BASELINE_URL=http://127.0.0.1:8461
WORKERS=2
DB_FILE=/var/lib/sentinelqa/sentinel.db
SUITES_DIR=/var/lib/sentinelqa/suites
ARTIFACTS_DIR=/var/lib/sentinelqa/artifacts
LLM_CACHE_DIR=/var/lib/sentinelqa/llm-cache
LLM_PROVIDER=groq
LLM_API_KEY=
ARENA_TOKEN=
PUBLIC_URL=https://r2-d2.xyz/sentinel/
ARENA_REPOS_FILE=/etc/sentinelqa/arena-repos.json
ARENA_WORK_DIR=/var/lib/sentinelqa/arena-repos
# Written by the one-click "Connect GitHub" setup (mode 600); holds the app's private key.
GITHUB_APP_FILE=/var/lib/sentinelqa/github-app.json
# Ticket a push is checked against when the repository has no sentinelqa.json.
GITHUB_DEFAULT_TICKET=SHOP-42
GITHUB_BUILD_PORT=8472
# Written by "Connect Jira" in the lobby (mode 600): site, account email, API token, webhook secret and project links.
JIRA_FILE=/var/lib/sentinelqa/jira.json
