# LLM used only to compile acceptance criteria into a test contract.
# Any OpenAI-compatible endpoint works. Presets: groq, gemini, openrouter.
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Jira Cloud (optional; without it, tickets are read from ./tickets)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_READY_STATUS=Ready for QA

# App under test and orchestrator
SHOPLITE_PORT=4100
SENTINEL_PORT=4200
TARGET_URL=http://localhost:4100
WORKERS=4
# Use an installed browser instead of the bundled one, e.g. msedge or chrome
# PW_CHANNEL=
